# NH-334 Highway Maintenance Dashboard - Environment Configuration
# Optional: Google Maps JavaScript API Key for embedded Google 360° Street View panoramas
# When unset, the dashboard utilizes Esri World Imagery (0.5m High-Resolution Satellite),
# Esri Boundaries & Places (Hybrid overlay), and OpenStreetMap (Road Map) tiles, with
# direct deep-links to launch official Google Maps Street View for every chainage.
VITE_GOOGLE_MAPS_API_KEY=

